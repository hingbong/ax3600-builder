# Build config for XIAOMI AX3600 on upstream openwrt/openwrt (main).
#
# This is a seed, not a full .config: CI copies it to openwrt/.config and runs
# "make defconfig", which pulls in every dependency and drops symbols that do
# not exist in the checked-out tree. Keep it to target + user-facing packages.
#
# The NSS stack (qca-nss-dp/drv/ecm, nss-firmware, sqm-scripts-nss) is gone;
# wired offload now comes from the in-tree qca_ppe/qca_edma drivers.

# --- Target ---------------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y
# TARGET_OPTIMIZATION only has a prompt when TARGET_OPTIONS is on, and
# TARGET_OPTIONS only when DEVEL is on. Without this line defconfig resets
# the string to DEFAULT_TARGET_OPTIMIZATION (-Os -mcpu=cortex-a53) and the
# optimization below is silently ignored (seen in the 2026-11-06-0648 build).
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_ZSTD=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256

# --- Toolchain (latest in main) --------------------------------------------
# TOOLCHAINOPTS lives under DEVEL ("Advanced configuration options"); without
# DEVEL defconfig silently drops the whole Toolchain Options menu.
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_BINUTILS_USE_VERSION_2_46=y

# --- Web UI ---------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# --- SSH: OpenSSH instead of Dropbear -------------------------------------
# The builder ships /etc/ssh/sshd_config, so sshd must be OpenSSH.
# CONFIG_PACKAGE_dropbear is not set
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-moduli=y

# --- DNS / DHCP -----------------------------------------------------------
# dnsmasq is replaced by hickory-dns (feed: hickory_dns) for DNS, while
# odhcpd serves DHCPv4/DHCPv6/RA. This matches the previous NSS builds.
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-full is not set
# CONFIG_PACKAGE_dnsmasq-dhcpv6 is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_hickory-dns=y
CONFIG_PACKAGE_ipv6-neigh=y
CONFIG_PACKAGE_zoneinfo-asia=y

# --- WiFi -----------------------------------------------------------------
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
# Stock 2.9.0.1 package stays: it also ships board-2.bin and the other files.
# The workflow overlays the WLAN.HK.2.12 q6_fw/m3_fw blobs from
# qosmio/upstream-wifi-fw 2.12-01460 into files/lib/firmware/IPQ8074/.
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_PACKAGE_ipq-wifi-xiaomi_ax3600=y

# --- WAN: PPPoE (pinned; do not rely on target defaults) --------------------
CONFIG_PACKAGE_ppp-mod-pppoe=y

# --- VPN ------------------------------------------------------------------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# --- SQM (software CAKE; the NSS script no longer exists) -----------------
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-ifb=y

# --- Restored from the NSS build (dropped in the first migration) ------------
CONFIG_PACKAGE_umdns=y
CONFIG_PACKAGE_mptcpd=y
CONFIG_PACKAGE_mptcpize=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_nstat=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_ell=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_pppoe-discovery=y

# --- SSL: OpenSSL everywhere (no mbedTLS) ----------------------------------
# ustream default variant is mbedtls; this flips it to openssl.
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_apk-openssl=y
# mbedTLS variants: do not even build them as modules
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_apk-mbedtls is not set
# CONFIG_PACKAGE_libmbedtls is not set
CONFIG_PACKAGE_xz-utils=y
# curl backend is a choice defaulting to mbedTLS; flip it (HTTP/3 needs it too).
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_HTTP3=y

# --- CLI tools ------------------------------------------------------------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_fping=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ip-tiny=y
